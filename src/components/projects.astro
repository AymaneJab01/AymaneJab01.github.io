<section
  id="projects"
  class="text-[var(--white)] py-24 md:py-36"
>
  <div class="max-w-5xl mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-2xl border border-[var(--white-icon-tr)]
      bg-[#1414149c] px-8 py-16 md:px-16 md:py-24
      text-center backdrop-blur-sm"
    >
      <!-- Subtle green glow -->
      <div
        class="absolute -top-24 left-1/2 h-48 w-48 -translate-x-1/2
        rounded-full bg-[var(--sec)] opacity-10 blur-3xl"
      ></div>

      <div class="relative">
        <!-- Small status indicator -->
        <div class="mb-6 flex items-center justify-center gap-2">
          <span
            class="h-2 w-2 rounded-full bg-[var(--sec)]
            shadow-[0_0_12px_var(--sec)] animate-pulse"
          ></span>

          <span
            class="text-sm tracking-widest uppercase
            text-[var(--white-icon)]"
          >
            In progress
          </span>
        </div>

        <!-- Main message -->
        <h2
          class="text-3xl md:text-5xl font-medium tracking-tight
          text-[var(--white)]"
        >
          Working on<span class="text-[var(--sec)]">.</span>
        </h2>

        <p
          class="mt-4 text-lg md:text-xl text-[var(--white-icon)]
          max-w-xl mx-auto leading-relaxed"
        >
          This section is currently under development.
          <br class="hidden md:block" />
          Will be updated shortly.
        </p>

        <!-- Decorative line -->
        <div class="mx-auto mt-8 h-px w-24 bg-[var(--sec)] opacity-60"></div>
      </div>
    </div>
  </div>
</section>