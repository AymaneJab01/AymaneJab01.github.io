<style is:global>
  .hero-grid {
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.026) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.026) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image:
      radial-gradient(
        ellipse 75% 65% at 50% 25%,
        black 15%,
        transparent 78%
      );

    -webkit-mask-image:
      radial-gradient(
        ellipse 75% 65% at 50% 25%,
        black 15%,
        transparent 78%
      );
  }

  .social-link {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;

    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.025);

    backdrop-filter: blur(12px);

    transition:
      color 300ms ease,
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .social-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.075);
    border-color: rgba(255, 255, 255, 0.18);
    transform: translateY(-3px);

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.2),
      0 0 20px rgba(86, 59, 220, 0.08);
  }

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        #7667ff 0%,
        #a99cff 20%,
        #ffffff 45%,
        #6251ff 70%,
        #7667ff 100%
      );

    background-size: 250% 100%;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation: shine 5s ease-in-out infinite;
  }

  @keyframes shine {
    0%,
    100% {
      background-position: 100% 50%;
    }

    50% {
      background-position: 0% 50%;
    }
  }

  .glitch-card {
    transition:
      transform 500ms cubic-bezier(.2, .8, .2, 1),
      border-color 500ms ease,
      box-shadow 500ms ease;
  }

  .glitch-card:hover {
    transform: translateY(-6px) rotate(0.3deg);

    border-color: rgba(255, 255, 255, 0.16);

    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(58, 31, 180, 0.08);
  }

  .hero-fade {
    animation: heroFade 800ms cubic-bezier(.2, .8, .2, 1) both;
  }

  .hero-fade:nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-fade:nth-child(3) {
    animation-delay: 140ms;
  }

  .hero-fade:nth-child(4) {
    animation-delay: 200ms;
  }

  .hero-fade:nth-child(5) {
    animation-delay: 260ms;
  }

  .hero-fade:nth-child(6) {
    animation-delay: 320ms;
  }

  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiny-sec,
    .hero-fade {
      animation: none;
    }

    .social-link,
    .glitch-card {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .hero-grid {
      background-size: 36px 36px;
    }

    .glitch-card:hover {
      transform: none;
    }
  }
</style>
