---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  id="home"
  class="relative isolate overflow-hidden text-[var(--white)]"
>
  <!-- =========================================================
       BACKGROUND
  ========================================================== -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <!-- Main purple glow -->
    <div
      class="absolute left-[42%] top-[-180px] h-[650px] w-[650px] -translate-x-1/2 rounded-full bg-[#3212b8]/20 blur-[150px]"
    ></div>

    <!-- Secondary glow -->
    <div
      class="absolute right-[-180px] top-[30%] h-[500px] w-[500px] rounded-full bg-[#172c9e]/15 blur-[140px]"
    ></div>

    <!-- Bottom glow -->
    <div
      class="absolute bottom-[-250px] left-[10%] h-[500px] w-[700px] rounded-full bg-[#3212b8]/10 blur-[160px]"
    ></div>

    <!-- Grid -->
    <div class="hero-grid absolute inset-0 opacity-40"></div>

    <!-- Vignette -->
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_20%,rgba(0,0,0,.35)_100%)]"
    ></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">

    <!-- =========================================================
         HERO
    ========================================================== -->
    <div
      class="grid min-h-[760px] items-center gap-16 py-24 sm:py-28 lg:grid-cols-[1.08fr_.92fr] lg:gap-20 lg:py-32"
    >

      <!-- LEFT -->
      <div class="relative z-10">

        <!-- Availability badge -->
        <div
          class="hero-fade mb-8 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.045] px-4 py-2 text-sm text-white/60 shadow-[0_0_30px_rgba(67,35,180,.08)] backdrop-blur-xl"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,.7)]"
            ></span>
          </span>

          <span>Open to opportunities</span>
        </div>

        <!-- Intro -->
        <p
          class="hero-fade mb-5 text-xs font-semibold uppercase tracking-[0.3em] text-white/40 sm:text-sm"
        >
          Hi, I'm Aymane Jabrane
        </p>

        <!-- Main heading -->
        <h1
          class="hero-fade max-w-5xl text-[3.7rem] font-semibold leading-[0.91] tracking-[-0.055em] sm:text-6xl md:text-7xl lg:text-[6.6rem]"
        >
          Software
          <span
            class="hero-gradient block bg-gradient-to-r from-white via-white/75 to-white/30 bg-clip-text text-transparent"
          >
            Developer.
          </span>
        </h1>

        <!-- Description -->
        <p
          class="hero-fade mt-8 max-w-2xl text-base leading-8 text-white/45 sm:text-lg sm:leading-8"
        >
          Building a
          <span class="shiny-sec font-medium">computer science</span>
          journey through code, systems and creative ideas.
          <span class="block">
            I enjoy turning complex problems into simple, useful software.
          </span>
        </p>

        <!-- CTA -->
        <div class="hero-fade mt-10 flex flex-wrap items-center gap-4">

          <!-- Primary CTA -->
          <a
            href="#projects"
            class="group relative inline-flex items-center gap-3 overflow-hidden rounded-xl bg-white px-6 py-3.5 text-sm font-semibold text-black shadow-[0_10px_40px_rgba(0,0,0,.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_15px_45px_rgba(255,255,255,.12)]"
          >
            <span
              class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-black/[0.06] to-transparent transition-transform duration-700 group-hover:translate-x-full"
            ></span>

            <span class="relative">View my work</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="relative size-4 transition-transform duration-300 group-hover:translate-x-1"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

          <!-- Socials -->
          <div class="flex items-center gap-2">

            <!-- GitHub -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/AymaneJab01"
              aria-label="GitHub"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-[18px]"
              >
                <path
                  d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
                />
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.linkedin.com/in/aymane-jabrane-73025726a/"
              aria-label="LinkedIn"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-[18px]"
              >
                <path
                  d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
                />
              </svg>
            </a>

            <!-- Email -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!"
              aria-label="Email Me"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-[18px]"
              >
                <path
                  d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
                />
              </svg>
            </a>
          </div>
        </div>

        <!-- Small stats -->
        <div
          class="hero-fade mt-12 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-white/[0.07] pt-7"
        >
          <div>
            <p class="text-xl font-semibold text-white">Code</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/30">
              Build & ship
            </p>
          </div>

          <div class="h-8 w-px bg-white/10"></div>

          <div>
            <p class="text-xl font-semibold text-white">Systems</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/30">
              Think deeper
            </p>
          </div>

          <div class="h-8 w-px bg-white/10"></div>

          <div>
            <p class="text-xl font-semibold text-white">Ideas</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/30">
              Create freely
            </p>
          </div>
        </div>
      </div>

      <!-- =======================================================
           RIGHT / GLITCH
      ======================================================== -->
      <div
        class="relative flex items-center justify-center lg:justify-end"
      >
        <!-- Glow -->
        <div
          class="absolute h-[350px] w-[350px] rounded-full bg-[#3212b8]/25 blur-[120px]"
        ></div>

        <!-- Decorative orbit -->
        <div
          class="absolute h-[440px] w-[440px] rounded-full border border-white/[0.035]"
        ></div>

        <div
          class="absolute h-[520px] w-[520px] rounded-full border border-white/[0.02]"
        ></div>

        <!-- Main card -->
        <div
          class="glitch-card relative aspect-square w-full max-w-[430px] overflow-hidden rounded-[2rem] border border-white/[0.11] bg-white/[0.025] p-2 shadow-[0_30px_100px_rgba(0,0,0,.45)] backdrop-blur-sm"
        >
          <!-- Inner border -->
          <div
            class="pointer-events-none absolute inset-2 rounded-[1.65rem] border border-white/[0.07] z-20"
          ></div>

          <!-- Top gradient -->
          <div
            class="pointer-events-none absolute left-8 right-8 top-0 z-30 h-px bg-gradient-to-r from-transparent via-purple-400/60 to-transparent"
          ></div>

          <!-- Glitch -->
          <div class="relative h-full w-full overflow-hidden rounded-[1.7rem]">
            <LetterGlitch
              client:load
              glitchColors={["#270d6d", "#1f0b81", "#241a38"]}
              glitchSpeed={33}
              centerVignette={false}
              outerVignette={true}
              smooth={true}
            />

            <!-- Overlay -->
            <div
              class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-white/[0.03]"
            ></div>
          </div>

          <!-- Corner label -->
          <div
            class="absolute bottom-6 left-6 z-30 rounded-lg border border-white/10 bg-black/45 px-3 py-2 text-[10px] font-mono uppercase tracking-[0.2em] text-white/45 backdrop-blur-xl"
          >
            &lt; build /&gt;
          </div>

          <!-- Top-right status -->
          <div
            class="absolute right-6 top-6 z-30 flex items-center gap-2 rounded-full border border-white/10 bg-black/35 px-3 py-1.5 text-[10px] font-mono uppercase tracking-[0.15em] text-white/40 backdrop-blur-xl"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
            online
          </div>
        </div>
      </div>
    </div>

    <!-- =========================================================
         TECHNOLOGIES
    ========================================================== -->
    <div class="relative border-y border-white/[0.07] py-12">

      <!-- Background glow -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-32 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple-500/[0.04] blur-3xl"
      ></div>

      <div class="relative">
        <div
          class="mb-8 flex flex-col items-center justify-between gap-3 sm:flex-row"
        >
          <p
            class="text-xs font-semibold uppercase tracking-[0.25em] text-white/30"
          >
            Technologies I work with
          </p>

          <span class="hidden text-xs text-white/20 sm:block">
            Tools for turning ideas into software
          </span>
        </div>

        <LogoWall />
      </div>
    </div>

    <!-- =========================================================
         SKILLS
    ========================================================== -->
    <div
      class="relative grid gap-14 py-28 lg:grid-cols-[.8fr_1.2fr] lg:items-start lg:gap-20"
    >

      <!-- Decorative vertical line -->
      <div
        class="pointer-events-none absolute left-0 top-20 hidden h-[calc(100%-10rem)] w-px bg-gradient-to-b from-purple-500/40 via-white/10 to-transparent lg:block"
      ></div>

      <!-- Left -->
      <div class="lg:pl-8">

        <div
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.025] px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.2em] text-purple-300/70"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
          Skills & tools
        </div>

        <h2
          class="max-w-xl text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-5xl"
        >
          Turning ideas into
          <span class="block text-white/30">working software.</span>
        </h2>

        <p
          class="mt-6 max-w-lg text-base leading-8 text-white/40"
        >
          A collection of technologies, tools and concepts I've been
          exploring throughout my development journey.
        </p>

        <div class="mt-8 flex items-center gap-3 text-xs text-white/25">
          <span class="h-px w-8 bg-purple-400/40"></span>
          <span>Always learning. Always building.</span>
        </div>
      </div>

      <!-- Right -->
      <div
        class="relative rounded-3xl border border-white/[0.07] bg-white/[0.018] p-6 shadow-[0_20px_80px_rgba(0,0,0,.2)] sm:p-8"
      >
        <!-- Card glow -->
        <div
          class="pointer-events-none absolute right-0 top-0 h-40 w-40 rounded-full bg-purple-600/[0.07] blur-[70px]"
        ></div>

        <div class="relative">
          <SkillsList client:load />
        </div>
      </div>
    </div>

    <!-- =========================================================
         BOTTOM STATEMENT
    ========================================================== -->
    <div
      class="relative overflow-hidden border-t border-white/[0.07] py-20 text-center"
    >
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple-600/[0.07] blur-[100px]"
      ></div>

      <div class="relative">
        <p
          class="text-xs font-semibold uppercase tracking-[0.3em] text-white/25"
        >
          What's next?
        </p>

        <h2
          class="mx-auto mt-5 max-w-3xl text-3xl font-semibold tracking-[-0.04em] text-white sm:text-4xl lg:text-5xl"
        >
          Building something
          <span class="text-white/30">worth remembering.</span>
        </h2>

        <a
          href="mailto:aymanejabranesm@gmail.com"
          class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-white/60 transition-colors duration-300 hover:text-white"
        >
          Let's talk

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="size-4"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"
            />
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style is="global">
  /* =========================================================
     GRID
  ========================================================== */

  .hero-grid {
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.026) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.026) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image:
      radial-gradient(
        ellipse 75% 65% at 50% 25%,
        black 15%,
        transparent 78%
      );

    -webkit-mask-image:
      radial-gradient(
        ellipse 75% 65% at 50% 25%,
        black 15%,
        transparent 78%
      );
  }

  /* =========================================================
     SOCIAL BUTTONS
  ========================================================== */

  .social-link {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 44px;
    height: 44px;

    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;

    color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.025);

    backdrop-filter: blur(12px);

    transition:
      color 300ms ease,
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .social-link:hover {
    color: white;

    background: rgba(255, 255, 255, 0.075);

    border-color: rgba(255, 255, 255, 0.18);

    transform: translateY(-3px);

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.2),
      0 0 20px rgba(86, 59, 220, 0.08);
  }

  /* =========================================================
     SHINY TEXT
  ========================================================== */

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        #7667ff 0%,
        #a99cff 20%,
        #ffffff 45%,
        #6251ff 70%,
        #7667ff 100%
      );

    background-size: 250% 100%;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation: shine 5s ease-in-out infinite;
  }

  @keyframes shine {
    0%,
    100% {
      background-position: 100% 50%;
    }

    50% {
      background-position: 0% 50%;
    }
  }

  /* =========================================================
     GLITCH CARD
  ========================================================== */

  .glitch-card {
    transition:
      transform 500ms cubic-bezier(.2,.8,.2,1),
      border-color 500ms ease,
      box-shadow 500ms ease;
  }

  .glitch-card:hover {
    transform: translateY(-6px) rotate(0.3deg);

    border-color: rgba(255, 255, 255, 0.16);

    box-shadow:
      0 40px 120px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(58, 31, 180, 0.08);
  }

  /* =========================================================
     HERO LOAD ANIMATION
  ========================================================== */

  .hero-fade {
    animation: heroFade 800ms cubic-bezier(.2,.8,.2,1) both;
  }

  .hero-fade:nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-fade:nth-child(3) {
    animation-delay: 140ms;
  }

  .hero-fade:nth-child(4) {
    animation-delay: 200ms;
  }

  .hero-fade:nth-child(5) {
    animation-delay: 260ms;
  }

  .hero-fade:nth-child(6) {
    animation-delay: 320ms;
  }

  @keyframes heroFade {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================================================
     ACCESSIBILITY
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {
    .shiny-sec,
    .hero-fade {
      animation: none;
    }

    .social-link,
    .glitch-card {
      transition: none;
    }
  }

  /* =========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 640px) {
    .hero-grid {
      background-size: 36px 36px;
    }

    .glitch-card:hover {
      transform: none;
    }
  }
</style>