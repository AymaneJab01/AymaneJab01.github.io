---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  id="home"
  class="relative overflow-hidden text-[var(--white)]"
>
  <!-- Ambient background -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-0 h-[600px] w-[700px] -translate-x-1/2 rounded-full bg-[#3212b8]/10 blur-[140px]"
    ></div>

    <div
      class="absolute right-[-200px] top-[35%] h-[400px] w-[400px] rounded-full bg-[#172c9e]/10 blur-[120px]"
    ></div>

    <div class="absolute inset-0 hero-grid opacity-30"></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- HERO -->
    <div
      class="grid min-h-[720px] items-center gap-14 py-24 lg:grid-cols-[1.15fr_.85fr] lg:py-28"
    >

      <!-- LEFT -->
      <div class="relative z-10">

        <!-- Status -->
        <div
          class="mb-7 inline-flex items-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-white/[0.035] px-3.5 py-2 text-sm text-[var(--white-icon)] backdrop-blur-md"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"
            ></span>
            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"
            ></span>
          </span>

          Open to opportunities
        </div>

        <p
          class="mb-4 text-sm font-medium uppercase tracking-[0.25em] text-[var(--white-icon)]"
        >
          Hi, I'm Aymane Jabrane
        </p>

        <h1
          class="max-w-4xl text-6xl font-semibold leading-[0.95] tracking-[-0.045em] sm:text-7xl lg:text-[5.8rem]"
        >
          Software
          <span class="block text-white/50">Developer.</span>
        </h1>

        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-[var(--white-icon)] sm:text-xl"
        >
          Building a 
          <span class="shiny-sec font-medium">
             computer science
          </span>
           journey through code, systems and creative ideas.
        </p>

        <!-- CTA / Socials -->
        <div class="mt-9 flex flex-wrap items-center gap-3">

          <a
            href="#projects"
            class="group inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3.5 text-sm font-medium text-black transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/90"
          >
            View my work

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-4 transition-transform duration-300 group-hover:translate-x-1"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

          <div class="flex items-center gap-2">

            <!-- GitHub -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/AymaneJab01"
              aria-label="GitHub"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
                ></path>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.linkedin.com/in/aymane-jabrane-73025726a/"
              aria-label="LinkedIn"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
                ></path>
              </svg>
            </a>

            <!-- Email -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!"
              aria-label="Email Me"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
                ></path>
              </svg>
            </a>

          </div>
        </div>
      </div>

      <!-- RIGHT / GLITCH -->
      <div class="relative flex items-center justify-center lg:justify-end">

        <!-- Glow -->
        <div
          class="absolute h-[280px] w-[280px] rounded-full bg-[#3212b8]/20 blur-[100px]"
        ></div>

        <!-- Card -->
        <div
          class="relative aspect-square w-full max-w-[390px] overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.025] p-2 shadow-2xl shadow-black/30 backdrop-blur-sm"
        >
          <div
            class="absolute inset-0 rounded-[1.7rem] border border-white/[0.06]"
          ></div>

          <div class="h-full w-full overflow-hidden rounded-[1.7rem]">
            <LetterGlitch
              client:load
              glitchColors={["#270d6d", "#1f0b81", "#241a38"]}
              glitchSpeed={33}
              centerVignette={false}
              outerVignette={true}
              smooth={true}
            />
          </div>

          <!-- Corner label -->
          <div
            class="absolute bottom-5 left-5 rounded-lg border border-white/10 bg-black/40 px-3 py-1.5 text-xs font-mono text-white/50 backdrop-blur-md"
          >
            {"< build />"}
          </div>
        </div>
      </div>
    </div>

    <!-- LOGOS -->
    <div
      class="border-y border-white/[0.06] py-10"
    >
      <p
        class="mb-7 text-center text-xs font-medium uppercase tracking-[0.25em] text-white/30"
      >
        Technologies I work with
      </p>

      <LogoWall />
    </div>

    <!-- SKILLS -->
    <div
      class="grid items-center gap-10 py-24 lg:grid-cols-[1fr_auto]"
    >
      <div>
        <p
          class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-[var(--sec)]"
        >
          Skills & tools
        </p>

        <h2
          class="max-w-xl text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          Turning ideas into
          <span class="text-white/40" >working software.</span>
        </h2>

        <p
          class="mt-4 max-w-lg text-base leading-relaxed text-white/45"
        >
          A collection of technologies, tools and concepts I've been
          exploring throughout my development journey.
        </p>

        <div class="mt-8">
          <SkillsList client:load />
        </div>
      </div>

      <div
        class="hidden h-px w-20 bg-gradient-to-r from-transparent via-white/20 to-transparent lg:block"
      ></div>
    </div>

  </div>
</section>

<style is:global>
  .hero-grid {
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 48px 48px;

    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 20%,
      black 20%,
      transparent 80%
    );
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--white-icon-tr);
    border-radius: 12px;
    color: var(--white-icon);
    background: rgba(20, 20, 20, 0.45);
    backdrop-filter: blur(10px);
    transition:
      color 300ms ease,
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  .social-link:hover {
    color: white;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        #7667ff 0%,
        #a99cff 25%,
        #ffffff 50%,
        #6251ff 75%,
        #7667ff 100%
      );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 5s ease-in-out infinite;
  }

  @keyframes shine {
    0%,
    100% {
      background-position: 100% 50%;
    }

    50% {
      background-position: 0% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiny-sec {
      animation: none;
    }

    .social-link {
      transition: none;
    }
  }
</style>