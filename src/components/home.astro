---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21 20C21 20.5523 20.5528 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"></path></svg>`,
  },
  {
    label: "Projects",
    href: "#projects",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M4 5V19H20V7H11.5858L9.58579 5H4ZM12.4142 5H21C21.5523 5 22 5.44772 22 6V20C22 20.5523 21.5523 21 21 21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H10.4142L12.4142 5Z"></path></svg>`,
  },
  {
    label: "Contact",
    href: "#contact",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.7267 2.95694L16.2734 22.0432C16.1225 22.5716 15.7979 22.5956 15.5563 22.1126L11 13L1.9229 9.36919C1.41322 9.16532 1.41953 8.86022 1.95695 8.68108L21.0432 2.31901C21.5716 2.14285 21.8747 2.43866 21.7267 2.95694ZM19.0353 5.09647L6.81221 9.17085L12.4488 11.4255L15.4895 17.5068L19.0353 5.09647Z"></path></svg>`,
  },
];
---

<div class="flex justify-center w-full">
  <nav
    id="main-nav"
    class="fixed left-1/2 -translate-x-1/2 z-[100] bg-[var(--background)] border border-transparent backdrop-blur-xl transition-all duration-500 ease-in-out md:top-6 md:bottom-auto bottom-0 w-full md:w-[80%]"
  >
    <div class="container mx-auto flex justify-center items-center p-3">
      <ul
        class="flex w-full justify-between md:space-x-6 md:justify-center md:gap-12 gap-2"
      >
        {
          navItems.map((item) => (
            <li class="flex-1 md:flex-none">
              <a
                href={item.href}
                class="nav-link flex flex-col items-center gap-1 text-[var(--white-icon)] transition-colors duration-300 text-xs md:text-base relative group"
              >
                <!-- Active desktop indicator -->
                <div
                  class="absolute -left-6 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full transition-all duration-300 scale-0 opacity-0 bg-[#A9FF5B] nav-indicator hidden md:block"
                />

                <!-- Mobile icon -->
                <span class="md:hidden flex items-center justify-center w-6 h-6">
                  <fragment set:html={item.icon} />
                </span>

                <!-- Desktop label -->
                <span class="nav-label hidden md:inline-block">
                  {item.label}
                </span>

                <!-- Mobile label -->
                <span class="nav-label md:hidden">
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<style>
  /* =========================================================
     NAV
  ========================================================== */

  nav {
    transform: translateX(-50%);

    background-color: var(--background);

    transition:
      background-color 0.3s ease,
      border-radius 0.3s ease,
      border-color 0.3s ease;
  }

  nav.scrolling {
    background-color: var(--component-bg);
    border-color: #ffffff10;
    border-radius: 9999px;
  }

  /* =========================================================
     NORMAL LINK
  ========================================================== */

  nav a {
    color: var(--white-icon);
  }

  nav a:hover {
    color: white;
  }

  /* =========================================================
     ACTIVE LINK
  ========================================================== */

  /*
   * IMPORTANT:
   *
   * The green glow is applied directly to the text.
   * text-shadow does NOT affect the layout or spacing.
   */

  nav a.active .nav-label {
    color: #a9ff5b;

    text-shadow:
      0 0 6px rgba(169, 255, 91, 0.75),
      0 0 14px rgba(169, 255, 91, 0.45),
      0 0 25px rgba(169, 255, 91, 0.2);
  }

  /*
   * Keep the link itself from becoming green.
   * Only .nav-label gets the glow.
   */

  nav a.active {
    color: var(--white-icon);
  }

  /* =========================================================
     ACTIVE DOT
  ========================================================== */

  nav a.active .nav-indicator {
    transform: translateY(-50%) scale(1);
    opacity: 1;

    box-shadow:
      0 0 5px #a9ff5b,
      0 0 12px rgba(169, 255, 91, 0.7);
  }

  /* =========================================================
     MOBILE
  ========================================================== */

  @media (max-width: 767px) {
    nav {
      width: 100% !important;

      left: 50%;
      bottom: 0;
      top: auto;

      transform: translateX(-50%);

      border-radius: 1rem 1rem 0 0;
      border-color: #ffffff10;

      background-color: var(--component-bg);
    }

    nav.scrolling {
      width: 100% !important;

      border-radius: 1rem 1rem 0 0;

      background-color: var(--component-bg);
    }

    nav .container {
      width: 100%;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    nav ul {
      width: 100%;
      gap: 0;
    }

    nav li {
      flex: 1;
      min-width: 0;
    }

    nav a {
      width: 100%;
      padding: 0.25rem 0.5rem;
      gap: 0.25rem;
    }

    /*
     * Hide the desktop green dot on mobile.
     */
    nav .nav-indicator {
      display: none !important;
    }

    /*
     * Active mobile text still gets the same
     * green glow.
     */
    nav a.active .nav-label {
      color: #a9ff5b;

      text-shadow:
        0 0 5px rgba(169, 255, 91, 0.7),
        0 0 12px rgba(169, 255, 91, 0.35);
    }

    /*
     * Mobile icons inherit the active color.
     */
    nav a.active svg {
      color: #a9ff5b;

      filter:
        drop-shadow(
          0 0 5px rgba(169, 255, 91, 0.65)
        )
        drop-shadow(
          0 0 12px rgba(169, 255, 91, 0.3)
        );
    }

    body {
      padding-bottom: 70px;
    }
  }

  /* =========================================================
     SMALL PHONES
  ========================================================== */

  @media (max-width: 380px) {
    nav .container {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
    }

    nav a {
      padding-left: 0.25rem;
      padding-right: 0.25rem;
    }

    nav a .nav-label {
      font-size: 0.65rem;
    }

    nav a span:first-of-type {
      width: 1.4rem;
      height: 1.4rem;
    }
  }

  /* =========================================================
     ACCESSIBILITY
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {
    nav,
    nav a,
    nav .nav-indicator {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  const maxScroll = 1000;

  let rafId: number | null = null;

  /* =========================================================
     NAV SCROLL EFFECT
  ========================================================== */

  function updateNav() {
    if (!nav) return;

    /*
     * Mobile:
     * Always keep the navbar at the bottom.
     */
    if (window.innerWidth < 768) {
      nav.classList.toggle(
        "scrolling",
        window.scrollY > 0
      );

      nav.style.removeProperty("width");

      rafId = null;

      return;
    }

    /*
     * Desktop:
     * Keep your original shrinking navbar.
     */
    if (window.scrollY > 0) {
      nav.classList.add("scrolling");

      const scrollProgress = Math.min(
        window.scrollY / maxScroll,
        1
      );

      const easeProgress =
        1 -
        Math.pow(
          1 - scrollProgress,
          4
        );

      const minWidth = 528;

      const maxWidth =
        window.innerWidth * 0.8;

      const currentWidth =
        maxWidth -
        (maxWidth - minWidth) *
          easeProgress;

      nav.style.setProperty(
        "width",
        `${currentWidth}px`
      );
    } else {
      nav.classList.remove("scrolling");

      nav.style.setProperty(
        "width",
        "80%"
      );
    }

    rafId = null;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!rafId) {
        rafId =
          requestAnimationFrame(
            updateNav
          );
      }
    },
    { passive: true }
  );

  window.addEventListener(
    "resize",
    () => {
      updateNav();
    },
    { passive: true }
  );

  /* =========================================================
     SMOOTH SCROLL
  ========================================================== */

  document
    .querySelectorAll('a[href^="#"]')
    .forEach((anchor) => {
      anchor.addEventListener(
        "click",
        (event) => {
          event.preventDefault();

          const target =
            event.currentTarget as HTMLAnchorElement;

          const targetId =
            target
              .getAttribute("href")
              ?.substring(1) || "";

          const targetElement =
            document.getElementById(
              targetId
            );

          if (targetElement) {
            /*
             * Immediately activate the
             * clicked navigation item.
             */
            document
              .querySelectorAll(
                "nav a"
              )
              .forEach((link) => {
                link.classList.remove(
                  "active"
                );
              });

            target.classList.add(
              "active"
            );

            targetElement.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        }
      );
    });

  /* =========================================================
     ACTIVE SECTION
  ========================================================== */

  function setupActiveSection() {
    const sections =
      document.querySelectorAll(
        "section[id]"
      );

    const navLinks =
      document.querySelectorAll(
        'nav a[href^="#"]'
      );

    if (
      !sections.length ||
      !navLinks.length
    ) {
      return;
    }

    const observerOptions: IntersectionObserverInit =
      {
        threshold: 0.35,
        rootMargin:
          "-10% 0px -45% 0px",
      };

    const observerCallback = (
      entries: IntersectionObserverEntry[]
    ) => {
      const visibleEntries =
        entries.filter(
          (entry) =>
            entry.isIntersecting
        );

      if (
        !visibleEntries.length
      ) {
        return;
      }

      /*
       * Pick the section closest to
       * the top of the viewport.
       */
      visibleEntries.sort(
        (a, b) =>
          Math.abs(
            a.boundingClientRect.top
          ) -
          Math.abs(
            b.boundingClientRect.top
          )
      );

      const activeSection =
        visibleEntries[0];

      const id =
        activeSection.target.getAttribute(
          "id"
        );

      if (!id) return;

      navLinks.forEach((link) => {
        link.classList.remove(
          "active"
        );
      });

      const activeLink =
        document.querySelector(
          `nav a[href="#${id}"]`
        );

      if (activeLink) {
        activeLink.classList.add(
          "active"
        );
      }
    };

    const observer =
      new IntersectionObserver(
        observerCallback,
        observerOptions
      );

    sections.forEach((section) => {
      observer.observe(section);
    });
  }

  /* =========================================================
     INITIALIZATION
  ========================================================== */

  function initializeNav() {
    /*
     * Home should glow immediately
     * when the page is opened.
     */
    if (window.scrollY <= 50) {
      const homeLink =
        document.querySelector(
          'nav a[href="#home"]'
        );

      if (homeLink) {
        homeLink.classList.add(
          "active"
        );
      }
    }

    updateNav();

    setupActiveSection();
  }

  /*
   * Astro may execute this script after
   * DOMContentLoaded, so handle both cases.
   */
  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initializeNav,
      { once: true }
    );
  } else {
    initializeNav();
  }
</script>