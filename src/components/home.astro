---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
---

<section
  id="home"
  class="relative overflow-hidden text-[var(--white)]"
>
  <!-- ========================================================= -->
  <!-- AMBIENT BACKGROUND -->
  <!-- ========================================================= -->

  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-[#3212b8]/10 blur-[140px] sm:h-[600px] sm:w-[700px]"
    ></div>

    <div
      class="absolute right-[-200px] top-[35%] h-[300px] w-[300px] rounded-full bg-[#172c9e]/10 blur-[120px] sm:h-[400px] sm:w-[400px]"
    ></div>

    <div class="absolute inset-0 hero-grid opacity-30"></div>
  </div>

  <div class="mx-auto max-w-6xl px-5 sm:px-8">

    <!-- ========================================================= -->
    <!-- HERO -->
    <!-- ========================================================= -->

    <div
      class="grid min-h-[auto] items-center gap-14 py-20 sm:py-24 lg:min-h-[720px] lg:grid-cols-[1.15fr_.85fr] lg:gap-14 lg:py-28"
    >

      <!-- ======================================================= -->
      <!-- LEFT -->
      <!-- ======================================================= -->

      <div class="relative z-10 min-w-0">

        <!-- STATUS -->
        <div
          class="mb-7 inline-flex max-w-full items-center gap-2 rounded-full border border-[var(--white-icon-tr)] bg-white/[0.035] px-3.5 py-2 text-sm leading-none text-[var(--white-icon)] backdrop-blur-md"
        >
          <span class="relative flex h-2 w-2 shrink-0">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"
            ></span>

            <span
              class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"
            ></span>
          </span>

          <span>Open to opportunities</span>
        </div>

        <!-- INTRO -->
        <p
          class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-[var(--white-icon)] sm:text-sm sm:tracking-[0.25em]"
        >
          Hi, I'm
          <span class="name-glow">Aymane Jabrane</span>
        </p>

        <!-- TITLE -->
        <h1
          class="max-w-4xl text-[3.4rem] font-semibold leading-[0.94] tracking-[-0.055em] sm:text-7xl lg:text-[5.8rem]"
        >
          Software
          <span class="block text-white/50">Developer.</span>
        </h1>

        <!-- DESCRIPTION -->
        <p
          class="mt-7 max-w-xl text-base leading-[1.65] text-[var(--white-icon)] sm:text-lg sm:leading-[1.65] lg:text-xl"
        >
          Building a
          <span class="shiny-sec font-medium">
             computer science 
          </span>
           journey through code, systems and creative ideas.
        </p>

        <!-- CTA / SOCIALS -->
        <div
          class="mt-8 flex flex-wrap items-center gap-3 sm:mt-9"
        >

          <!-- VIEW WORK -->
          <a
            href="#projects"
            class="group inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3.5 text-sm font-medium leading-none text-black transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/90"
          >
            <span>View my work</span>

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"
              />
            </svg>
          </a>

          <!-- SOCIALS -->
          <div class="flex items-center gap-2">

            <!-- GITHUB -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://github.com/AymaneJab01"
              aria-label="GitHub"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
                />
              </svg>
            </a>

            <!-- LINKEDIN -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://www.linkedin.com/in/aymane-jabrane-73025726a/"
              aria-label="LinkedIn"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6697 3Z"
                />
              </svg>
            </a>

            <!-- EMAIL -->
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://mail.google.com/mail/?view=cm&fs=1&to=aymanejabranesm@gmail.com&su=Hey%20Jabrane!"
              aria-label="Email Me"
              class="social-link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-5"
              >
                <path
                  d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
                />
              </svg>
            </a>

          </div>
        </div>
      </div>

      <!-- ======================================================= -->
      <!-- RIGHT / GLITCH -->
      <!-- ======================================================= -->

      <div
        class="relative flex items-center justify-center lg:justify-end"
      >

        <!-- GLOW -->
        <div
          class="absolute h-[220px] w-[220px] rounded-full bg-[#3212b8]/20 blur-[100px] sm:h-[280px] sm:w-[280px]"
        ></div>

        <!-- CARD -->
        <div
          class="relative aspect-square w-full max-w-[330px] overflow-hidden rounded-[1.75rem] border border-white/10 bg-white/[0.025] p-2 shadow-2xl shadow-black/30 backdrop-blur-sm sm:max-w-[390px]"
        >

          <div
            class="absolute inset-0 rounded-[1.5rem] border border-white/[0.06]"
          ></div>

          <div class="h-full w-full overflow-hidden rounded-[1.5rem]">
            <LetterGlitch
              client:load
              glitchColors={["#270d6d", "#1f0b81", "#241a38"]}
              glitchSpeed={33}
              centerVignette={false}
              outerVignette={true}
              smooth={true}
            />
          </div>

          <!-- LABEL -->
          <div
            class="absolute bottom-4 left-4 rounded-lg border border-white/10 bg-black/40 px-3 py-1.5 text-xs font-mono leading-none text-white/50 backdrop-blur-md sm:bottom-5 sm:left-5"
          >
            {"< build />"}
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- TECHNOLOGIES -->
    <!-- ========================================================= -->

    <div class="border-y border-white/[0.06] py-10 sm:py-12">

      <p
        class="mb-7 text-center text-[10px] font-medium uppercase leading-none tracking-[0.22em] text-white/30 sm:text-xs sm:tracking-[0.25em]"
      >
        Technologies I work with
      </p>

      <LogoWall />
    </div>

    <!-- ========================================================= -->
    <!-- SKILLS -->
    <!-- ========================================================= -->

    <div
      class="grid items-center gap-10 py-20 sm:py-24 lg:grid-cols-[1fr_auto]"
    >

      <div class="min-w-0">

        <p
          class="mb-3 text-xs font-medium uppercase leading-none tracking-[0.18em] text-[var(--sec)] sm:text-sm sm:tracking-[0.2em]"
        >
          Skills & tools
        </p>

        <h2
          class="max-w-xl text-3xl font-semibold leading-[1.08] tracking-[-0.035em] text-white sm:text-4xl"
        >
          <span class="whitespace-nowrap">
            Turning ideas into
          </span>

          <span class="block text-white/40">
            working software.
          </span>
        </h2>

        <p
          class="mt-5 max-w-lg text-base leading-[1.7] text-white/45"
        >
          A collection of technologies, tools and concepts I've been
          exploring throughout my development journey.
        </p>

        <div class="mt-8">
          <SkillsList client:load />
        </div>
      </div>

      <div
        class="hidden h-px w-20 bg-gradient-to-r from-transparent via-white/20 to-transparent lg:block"
      ></div>
    </div>

    <!-- ========================================================= -->
    <!-- ADDITIONAL NOTES -->
    <!-- ========================================================= -->

    <div
      id="notes"
      class="border-t border-white/[0.06] py-20 sm:py-24"
    >

      <div class="max-w-2xl">

        <p
          class="mb-3 text-xs font-medium uppercase leading-none tracking-[0.18em] text-emerald-400 sm:text-sm sm:tracking-[0.2em]"
        >
          Things I've studied & explored
        </p>

        <h2
          class="text-3xl font-semibold leading-[1.08] tracking-[-0.035em] text-white sm:text-4xl"
        >
          Notes, ideas &
          <span class="text-white/40">
            things I've learned.
          </span>
        </h2>

        <p
          class="mt-5 max-w-xl text-base leading-[1.7] text-white/45"
        >
          A collection of notes and concepts I've been studying along
          my computer science journey.
        </p>

      </div>

      <!-- NOTES GRID -->
      <div
        class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >

        <!-- NOTE 1 -->
        <a
          href="https://app.notion.com/p/Tablas-Hash-Vista-Practica-3a762e0580cb80de84eee02fade92863?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Hash Tables
          </span>

          <h3>
            Tablas Hash — Vista Práctica
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

        <!-- NOTE 2 -->
        <a
          href="https://app.notion.com/p/Computer-from-hardware-perspective-3a362e0580cb80cfbfa5f1228d060bcc?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Computer Science
          </span>

          <h3>
            Computer from a Hardware Perspective
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

        <!-- NOTE 3 -->
        <a
          href="https://app.notion.com/p/Tablas-Hash-Definiciones-3a662e0580cb80089dd9c287f8864a93?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Data Structures
          </span>

          <h3>
            Tablas Hash — Definiciones
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

        <!-- NOTE 4 -->
        <a
          href="https://app.notion.com/p/Git-Github-3a562e0580cb801089e5d47fbbaa221f?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Development
          </span>

          <h3>
            Git & GitHub
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

        <!-- NOTE 5 -->
        <a
          href="https://app.notion.com/p/Syst-me-Signaux-Analogue-vs-Digitale-3b062e0580cb80d3ba80cb3e8232dee1?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Systems
          </span>

          <h3>
            Système — Signaux Analogues vs Digitaux
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

        <!-- NOTE 6 -->
        <a
          href="https://app.notion.com/p/Java-3a262e0580cb8037bee0c0e9aa4b480c?source=copy_link"
          target="_blank"
          rel="noopener noreferrer"
          class="note-card"
        >
          <span class="note-label">
            Programming
          </span>

          <h3>
            Java
          </h3>

          <span class="note-arrow">
            ↗
          </span>
        </a>

      </div>
    </div>

    <!-- ========================================================= -->
    <!-- CTA -->
    <!-- ========================================================= -->

    <div
      class="border-t border-white/[0.06] py-20 text-center sm:py-24"
    >

      <p
        class="mb-4 text-xs font-medium uppercase leading-none tracking-[0.2em] text-white/30 sm:text-sm"
      >
        Have an idea?
      </p>

      <h2
        class="mx-auto max-w-2xl text-4xl font-semibold leading-[1] tracking-[-0.045em] text-white sm:text-5xl"
      >
        Let's build

        <span class="shiny-sec">
          something together.
        </span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-lg text-base leading-[1.7] text-white/45"
      >
        Whether it's a project, an idea or simply a conversation,
        I'd love to hear from you.
      </p>

      <a
        href="#contact"
        class="talk-button mt-8 inline-flex items-center gap-2 rounded-xl px-6 py-3.5 text-sm font-medium"
      >
        Let's talk

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-4"
        >
          <path
            fill-rule="evenodd"
            d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
            clip-rule="evenodd"
          />
        </svg>
      </a>

    </div>

  </div>
</section>

<!-- ============================================================= -->
<!-- GLOBAL STYLES -->
<!-- ============================================================= -->

<style is:global>

  /* ============================================================= */
  /* HERO GRID */
  /* ============================================================= */

  .hero-grid {
    background-image:
      linear-gradient(
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 20%,
      black 20%,
      transparent 80%
    );
  }

  /* ============================================================= */
  /* GREEN NAME GLOW */
  /* ============================================================= */

  .name-glow {
    color: #86efac;

    text-shadow:
      0 0 8px rgba(74, 222, 128, 0.45),
      0 0 18px rgba(74, 222, 128, 0.25);

    transition:
      color 300ms ease,
      text-shadow 300ms ease;
  }

  .name-glow:hover {
    color: #bbf7d0;

    text-shadow:
      0 0 10px rgba(74, 222, 128, 0.7),
      0 0 25px rgba(74, 222, 128, 0.4);
  }

  /* ============================================================= */
  /* SHINY TEXT */
  /* Used by:
     - computer science
     - something together.
  */
  /* ============================================================= */

  .shiny-sec {
    background:
      linear-gradient(
        110deg,
        #7667ff 0%,
        #a99cff 25%,
        #ffffff 50%,
        #6251ff 75%,
        #7667ff 100%
      );

    background-size: 250% 100%;

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;

    animation: shine 5s ease-in-out infinite;
  }

  @keyframes shine {

    0%,
    100% {
      background-position: 100% 50%;
    }

    50% {
      background-position: 0% 50%;
    }
  }

  /* ============================================================= */
  /* SOCIAL BUTTONS */
  /* ============================================================= */

  .social-link {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    border: 1px solid var(--white-icon-tr);
    border-radius: 12px;

    color: var(--white-icon);

    background: rgba(20, 20, 20, 0.45);

    backdrop-filter: blur(10px);

    transition:
      color 300ms ease,
      background 300ms ease,
      border-color 300ms ease,
      transform 300ms ease;
  }

  .social-link:hover {
    color: white;

    background: rgba(255, 255, 255, 0.08);

    border-color: rgba(255, 255, 255, 0.2);

    transform: translateY(-2px);
  }

  /* ============================================================= */
  /* NOTE CARDS */
  /* ============================================================= */

  .note-card {
    position: relative;

    display: flex;
    min-height: 180px;

    flex-direction: column;
    justify-content: space-between;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 18px;

    padding: 22px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.045),
        rgba(255, 255, 255, 0.015)
      );

    color: white;

    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background 300ms ease,
      box-shadow 300ms ease;
  }

  .note-card:hover {
    transform: translateY(-4px);

    border-color: rgba(74, 222, 128, 0.3);

    background:
      linear-gradient(
        145deg,
        rgba(74, 222, 128, 0.06),
        rgba(255, 255, 255, 0.02)
      );

    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.2),
      0 0 30px rgba(74, 222, 128, 0.04);
  }

  .note-label {
    font-size: 11px;
    font-weight: 500;

    text-transform: uppercase;
    letter-spacing: 0.14em;

    line-height: 1;

    color: rgba(74, 222, 128, 0.7);
  }

  .note-card h3 {
    max-width: 90%;

    margin-top: 24px;

    font-size: 1.05rem;
    font-weight: 500;

    line-height: 1.35;
    letter-spacing: -0.015em;

    color: rgba(255, 255, 255, 0.85);
  }

  .note-arrow {
    position: absolute;

    right: 20px;
    bottom: 18px;

    font-size: 18px;

    color: rgba(255, 255, 255, 0.3);

    transition:
      color 300ms ease,
      transform 300ms ease;
  }

  .note-card:hover .note-arrow {
    color: #86efac;
    transform: translate(2px, -2px);
  }

  /* ============================================================= */
  /* LET'S TALK BUTTON */
  /* ============================================================= */

  .talk-button {
    color: #bbf7d0;

    border: 1px solid rgba(74, 222, 128, 0.25);

    background:
      linear-gradient(
        135deg,
        rgba(74, 222, 128, 0.12),
        rgba(74, 222, 128, 0.04)
      );

    box-shadow:
      0 0 20px rgba(74, 222, 128, 0.08);

    transition:
      transform 300ms ease,
      border-color 300ms ease,
      background 300ms ease,
      box-shadow 300ms ease;
  }

  .talk-button:hover {
    transform: translateY(-2px);

    border-color: rgba(74, 222, 128, 0.5);

    background:
      linear-gradient(
        135deg,
        rgba(74, 222, 128, 0.18),
        rgba(74, 222, 128, 0.07)
      );

    box-shadow:
      0 0 12px rgba(74, 222, 128, 0.18),
      0 0 35px rgba(74, 222, 128, 0.1);
  }

  /* ============================================================= */
  /* MOBILE */
  /* ============================================================= */

  @media (max-width: 640px) {

    .hero-grid {
      background-size: 36px 36px;
    }

    .note-card {
      min-height: 160px;
      padding: 20px;
    }

    .note-card h3 {
      font-size: 1rem;
      line-height: 1.4;
    }

    .shiny-sec {
      white-space: normal;
    }
  }

  /* ============================================================= */
  /* REDUCED MOTION */
  /* ============================================================= */

  @media (prefers-reduced-motion: reduce) {

    .shiny-sec {
      animation: none;
    }

    .social-link,
    .note-card,
    .note-arrow,
    .talk-button {
      transition: none;
    }
  }

</style>